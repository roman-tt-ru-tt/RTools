<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== ActionBar ===== -->
    <style name="AppActionBar" parent="@android:style/Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">#7C3AED</item>
        <item name="android:titleTextStyle">@style/AppActionBarTitle</item>
        <item name="android:elevation">1dp</item>
    </style>
    <style name="AppActionBarTitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <!-- ===== Main theme ===== -->
    <style name="AppMainTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1A0B2E</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
        <item name="android:actionMenuTextColor">#FFFFFFFF</item>
        <item name="android:colorPrimary">#7C3AED</item>
        <item name="android:colorPrimaryDark">#1A0B2E</item>
        <item name="android:colorAccent">#A78BFA</item>
        <item name="android:statusBarColor">#1A0B2E</item>
        <item name="android:navigationBarColor">#1A0B2E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ===== App theme ===== -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1A0B2E</item>
        <item name="android:colorPrimary">#7C3AED</item>
        <item name="android:colorPrimaryDark">#1A0B2E</item>
        <item name="android:colorAccent">#A78BFA</item>
        <item name="android:statusBarColor">#1A0B2E</item>
        <item name="android:navigationBarColor">#1A0B2E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">#1A0B2E</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#A78BFA</item>
    </style>

    <!-- ===== Диалоги (фиолетовые) ===== -->
    <style name="GlassDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#C4B5FD</item>
        <item name="android:windowBackground">@drawable/glass_dialog_dark</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:colorAccent">#A78BFA</item>
        <item name="android:colorControlActivated">#7C3AED</item>
        <item name="android:colorControlNormal">#A78BFA</item>
    </style>

    <!-- ===== Тёмная тема для ADM-форм ===== -->
    <style name="AdminFormsTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0d0a1f</item>
        <item name="android:statusBarColor">#0d0a1f</item>
        <item name="android:colorAccent">#00e5c0</item>
        <item name="android:colorPrimary">#0d0a1f</item>
        <item name="android:colorPrimaryDark">#0d0a1f</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ===== Стиль тумблера (Switch) ===== -->
    <style name="SwitchStyle" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:showText">false</item>
    </style>
</resources>
